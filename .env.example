# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — real keys never get committed.
#
# Anything that is NOT prefixed with NEXT_PUBLIC_ stays on the server and is
# never shipped to the browser. Keep it that way for the TMDB credentials.
# ---------------------------------------------------------------------------

# REQUIRED — your free TMDB API key (v3 auth).
# Get one at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OPTIONAL — TMDB v4 read access token. If set, it is used instead of the
# API key above (sent as a Bearer token). Either one works on its own.
TMDB_ACCESS_TOKEN=

# OPTIONAL — public base URL of your deployment, used for SEO / OpenGraph tags.
# Example: https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SUBTITLES — the translated Kurdish (Sorani) track
# ---------------------------------------------------------------------------
# Both keys are server-only: the browser never sees either, and neither may be
# prefixed with NEXT_PUBLIC_. Leave them blank to switch the feature off
# entirely — playback carries on exactly as it does now, with no subtitle.
#
# Your Wyzie Subs API key, used to find the subtitle that gets translated.
# Free keys allow 1,000 requests a day. Get one at: https://store.wyzie.io/redeem
WYZIE_API_KEY=

# Google Translate API key, used to translate it. Create one in a Google Cloud
# project with the Cloud Translation API enabled.
TRANSLATE_API_KEY=

# OPTIONAL — where translated subtitles are stored.
#
# Leave this unset and subtitles are written to `subtitles.cacheDir`
# (./tmp/subtitles) instead, which is right for local development: no account,
# no credentials, and the files sit where you can open them.
#
# Set it for any real deployment. A directory cannot serve a subtitle to a
# viewer's browser on a serverless host — the bundle is read-only, `/tmp`
# belongs to a single instance, and the request that fetches the file is
# routinely answered by an instance that never wrote it. Object storage is the
# piece that is actually shared.
#
# On Vercel this is set for you: create a Blob store in the dashboard and link
# it to the project, and the token below is injected into builds automatically.
# Nothing to copy. Blob is free on the Hobby plan within its limits — 1 GB of
# storage, which is roughly ten thousand subtitles — and needs no payment
# method.
#
# Set it by hand only when self-hosting against the same store.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# ALTERNATIVE STORE — Cloudflare R2
# ---------------------------------------------------------------------------
# Only needed if you would rather use R2 than Blob. It is the better store on
# paper — 10 GB free and no egress charges at all, where every subtitle
# download is a viewer pulling a file — but it asks for a card on file, and
# Blob does not. Setting these alongside a Blob token has no effect: Blob wins.
#
# Create a bucket, make it publicly readable, and add a CORS policy allowing
# GET from any origin — the player fetches the subtitle cross-origin, and a
# missing CORS rule is a subtitle that silently never appears. Then create an
# R2 API token with object read & write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# OPTIONAL — the public base URL the bucket is served from, such as
# https://pub-xxxxxxxx.r2.dev or your own domain. Without it files are still
# stored and read correctly, they are just served through /api/subtitles/…
# instead of being handed to the player directly — which works, but spends
# your hosting bandwidth re-serving bytes the store could have sent.
R2_PUBLIC_BASE_URL=

# OPTIONAL — override the storage directory used when R2 is not configured.
# Defaults to ./tmp/subtitles.
SUBTITLE_CACHE_DIR=
